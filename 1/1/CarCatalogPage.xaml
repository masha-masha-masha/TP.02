<Page x:Class="Прокат_авто.CarCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог автомобилей"
      Background="#ECF0F1">

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Поиск -->
		<Border Grid.Row="0" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10">
			<StackPanel>
				<TextBlock Text="Поиск автомобиля" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
				<TextBox x:Name="txtSearch" TextChanged="txtSearch_TextChanged" Margin="0,0,0,10"/>
			</StackPanel>
		</Border>

		<!-- Фильтр и сортировка -->
		<Border Grid.Row="1" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Margin="0,0,10,0">
					<TextBlock Text="Фильтр по статусу" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
					<ComboBox x:Name="cmbStatusFilter" SelectionChanged="cmbStatusFilter_SelectionChanged">
						<ComboBoxItem Content="Все" IsSelected="True"/>
						<ComboBoxItem Content="свободен"/>
						<ComboBoxItem Content="в аренде"/>
						<ComboBoxItem Content="на ТО"/>
						<ComboBoxItem Content="продан"/>
					</ComboBox>
				</StackPanel>

				<StackPanel Grid.Column="1">
					<TextBlock Text="Сортировка" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
					<ComboBox x:Name="cmbSort" SelectionChanged="cmbSort_SelectionChanged">
						<ComboBoxItem Content="По умолчанию" IsSelected="True"/>
						<ComboBoxItem Content="По цене (возрастание)"/>
						<ComboBoxItem Content="По цене (убывание)"/>
						<ComboBoxItem Content="По марке (А-Я)"/>
						<ComboBoxItem Content="По марке (Я-А)"/>
						<ComboBoxItem Content="По году выпуска (новые)"/>
						<ComboBoxItem Content="По году выпуска (старые)"/>
					</ComboBox>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Список автомобилей -->
		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<ItemsControl x:Name="carsItemsControl">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="200"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<!-- Фото -->
								<Border Grid.Column="0" Width="180" Height="120" Background="#BDC3C7" 
        CornerRadius="3" Margin="0,0,10,0">
									<Image Width="180" Height="120" 
           Stretch="UniformToFill"
           Source="{Binding CarImage}">
										<Image.ToolTip>
											<ToolTip>
												<StackPanel>
													<TextBlock Text="{Binding Stamp}" FontWeight="Bold"/>
													<TextBlock Text="{Binding Model}"/>
												</StackPanel>
											</ToolTip>
										</Image.ToolTip>
									</Image>
								</Border>

								<!-- Информация -->
								<StackPanel Grid.Column="1">
									<TextBlock FontSize="16" FontWeight="Bold">
                                        <Run Text="{Binding Stamp}"/> <Run Text="{Binding Model}"/>
									</TextBlock>
									<TextBlock Margin="0,5,0,0">
                                        <Run Text="Год: "/><Run Text="{Binding YearOfRelease}"/>
                                        <Run Text=" | Цвет: "/><Run Text="{Binding Colour}"/>
									</TextBlock>
									<TextBlock>
                                        <Run Text="Пробег: "/><Run Text="{Binding Mileage}"/> км
									</TextBlock>
									<TextBlock>
                                        <Run Text="Статус: "/>
                                        <Run Text="{Binding StatusTitle}" 
                                             Foreground="{Binding StatusColor}"/>
									</TextBlock>
									<TextBlock FontSize="18" FontWeight="Bold" Foreground="#27AE60">
                                        <Run Text="{Binding PricePerDay}"/> руб/день
									</TextBlock>
								</StackPanel>

								<!-- Кнопка аренды -->
								<Button Grid.Column="2" Content="Арендовать" Width="120" Height="40"
                                        Background="#27AE60" Foreground="White" FontWeight="Bold"
                                        Click="RentCar_Click" Tag="{Binding IdCar}"
                                        IsEnabled="{Binding CanRent}"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</Page>