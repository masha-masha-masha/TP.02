<Page x:Class="Прокат_авто.ClientContractsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои договоры"
      Background="#ECF0F1">

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Заголовок -->
		<Border Grid.Row="0" Background="#2C3E50" CornerRadius="5" Padding="15" Margin="0,0,0,10">
			<StackPanel>
				<TextBlock Text="📄 Мои договоры аренды" FontSize="20" FontWeight="Bold" Foreground="White"/>
				<TextBlock Text="История всех ваших арендованных автомобилей" FontSize="12" Foreground="#BDC3C7" Margin="0,5,0,0"/>
			</StackPanel>
		</Border>

		<!-- Фильтры -->
		<Border Grid.Row="1" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Margin="0,0,10,0">
					<TextBlock Text="Фильтр по статусу" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
					<ComboBox x:Name="cmbStatusFilter" SelectionChanged="cmbStatusFilter_SelectionChanged" Width="150">
						<ComboBoxItem Content="Все договоры" IsSelected="True"/>
						<ComboBoxItem Content="Активные"/>
						<ComboBoxItem Content="Завершенные"/>
						<ComboBoxItem Content="Отмененные"/>
					</ComboBox>
				</StackPanel>

				<StackPanel Grid.Column="1">
					<TextBlock Text="Поиск по автомобилю" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
					<TextBox x:Name="txtSearch" TextChanged="txtSearch_TextChanged" Width="200"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Список договоров -->
		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<ItemsControl x:Name="contractsItemsControl">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,10">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<!-- Верхняя часть: номер договора и статус -->
								<Grid Grid.Row="0" Margin="0,0,0,10">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<StackPanel Grid.Column="0" Orientation="Horizontal">
										<TextBlock Text="Договор №" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
										<TextBlock Text="{Binding ContractId}" FontSize="16" FontWeight="Bold" Foreground="#3498DB" Margin="5,0,0,0"/>
									</StackPanel>

									<Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="10" Padding="10,3">
										<TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="12"/>
									</Border>
								</Grid>

								<!-- Основная информация -->
								<Border Grid.Row="1" Background="#F8F9FA" Padding="10">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<!-- Левая колонка -->
										<StackPanel Grid.Column="0" Margin="0,0,20,0">
											<TextBlock FontSize="14" FontWeight="Bold" Foreground="#2C3E50">
                                                <Run Text="🚗 "/><Run Text="{Binding CarName}"/>
											</TextBlock>
											<TextBlock Margin="0,10,0,0">
                                                <Run Text="📅 Дата начала: "/>
                                                <Run Text="{Binding StartDate}" FontWeight="Bold"/>
											</TextBlock>
											<TextBlock>
                                                <Run Text="📅 Дата окончания: "/>
                                                <Run Text="{Binding EndDate}" FontWeight="Bold"/>
											</TextBlock>
											<TextBlock>
                                                <Run Text="💰 Стоимость в день: "/>
                                                <Run Text="{Binding RentalAmount}" FontWeight="Bold" Foreground="#27AE60"/>
                                                <Run Text=" руб."/>
											</TextBlock>
										</StackPanel>

										<!-- Правая колонка -->
										<StackPanel Grid.Column="1">
											<TextBlock FontSize="14" FontWeight="Bold" Foreground="#2C3E50">Детали договора</TextBlock>
											<TextBlock Margin="0,10,0,0">
                                                <Run Text="📊 Итоговая сумма: "/>
                                                <Run Text="{Binding TotalAmount}" FontWeight="Bold" Foreground="#E74C3C" FontSize="16"/>
                                                <Run Text=" руб."/>
											</TextBlock>
											<TextBlock>
                                                <Run Text="🔄 Количество дней: "/>
                                                <Run Text="{Binding DaysCount}" FontWeight="Bold"/>
											</TextBlock>
										</StackPanel>

										<!-- Кнопки действий -->
										<StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="110">
											<Button Content="📄 Детали" Width="110" Height="35" Margin="0,0,0,8"
                                                    Background="#3498DB" Foreground="White" FontSize="12"
                                                    Click="ViewDetails_Click" Tag="{Binding ContractId}"
                                                    Visibility="{Binding ShowDetailsButton}"/>
											<Button Content="❌ Отменить" Width="110" Height="35"
                                                    Background="#E74C3C" Foreground="White" FontSize="12"
                                                    Click="CancelContract_Click" Tag="{Binding ContractId}"
                                                    Visibility="{Binding ShowCancelButton}"/>
										</StackPanel>
									</Grid>
								</Border>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<!-- Статистика -->
		<Border Grid.Row="3" Background="White" CornerRadius="5" Padding="10" Margin="0,10,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Border Grid.Column="0" Background="#27AE60" CornerRadius="5" Padding="10" Margin="5">
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="Всего договоров" Foreground="White" FontSize="12"/>
						<TextBlock x:Name="txtTotalContracts" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
					</StackPanel>
				</Border>

				<Border Grid.Column="1" Background="#3498DB" CornerRadius="5" Padding="10" Margin="5">
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="Активных" Foreground="White" FontSize="12"/>
						<TextBlock x:Name="txtActiveContracts" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
					</StackPanel>
				</Border>

				<Border Grid.Column="2" Background="#F39C12" CornerRadius="5" Padding="10" Margin="5">
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="Завершено" Foreground="White" FontSize="12"/>
						<TextBlock x:Name="txtCompletedContracts" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
					</StackPanel>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Page>