<Window x:Class="Прокат_авто.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация нового клиента" 
        Height="520" 
        Width="450"
		Background="#1A237E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Grid Margin="25" >
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Заголовок -->
			<TextBlock Grid.Row="0" Text="Регистрация нового клиента" 
                       FontSize="22" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,35"
                       Foreground="White"/>

			<!-- Логин -->
			<TextBlock Grid.Row="1" Text="Логин:" FontSize="14" 
                       FontWeight="SemiBold" Margin="0,0,0,8" Foreground="White"/>
			<TextBox Grid.Row="2" x:Name="txtLogin" 
                     
                     KeyDown="TxtLogin_KeyDown"
                     Margin="0,0,0,20"/>

			<!-- Пароль -->
			<TextBlock Grid.Row="3" Text="Пароль:" FontSize="14" 
                       FontWeight="SemiBold" Margin="0,0,0,8" Foreground="White"/>
			<PasswordBox Grid.Row="4" x:Name="txtPassword" 
                         KeyDown="TxtPassword_KeyDown"
                         Margin="0,0,0,20"/>

			<!-- Подтверждение пароля -->
			<TextBlock Grid.Row="5" Text="Подтверждение пароля:" FontSize="14" 
                       FontWeight="SemiBold" Margin="0,0,0,8" Foreground="White"/>
			<PasswordBox Grid.Row="6" x:Name="txtConfirmPassword" 
                         KeyDown="TxtConfirmPassword_KeyDown"
                         Margin="0,0,0,25"/>

			<!-- Кнопки -->
			<StackPanel Grid.Row="7" Orientation="Horizontal" 
                        HorizontalAlignment="Center" Margin="0,20,0,0">
				<Button x:Name="btnRegister" Content="Зарегистрироваться" 
         
                        Click="btnRegister_Click" Margin="0,0,15,0" Background="#3498DB"/>
				<Button x:Name="btnCancel" Content="Отмена" 
                        
                        Click="btnCancel_Click" Background="#7F8C8D"/>
			</StackPanel>

			<!-- Статус -->
			<TextBlock Grid.Row="8" x:Name="txtStatus" 
                       TextAlignment="Center" Margin="0,20,0,10"
                       FontSize="13" Foreground="Red"/>
		</Grid>
	</ScrollViewer>
</Window>