<Window x:Class="Прокат_авто.RentCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление аренды" 
        Height="450" 
        Width="500"
        WindowStartupLocation="CenterOwner">

	<Grid Margin="20">
		<StackPanel>
			<TextBlock Text="Оформление договора аренды" FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

			<TextBlock Text="Дата начала:" FontWeight="Bold"/>
			<DatePicker x:Name="dpStartDate" Margin="0,5,0,15"/>

			<TextBlock Text="Дата окончания:" FontWeight="Bold"/>
			<DatePicker x:Name="dpEndDate" Margin="0,5,0,15"/>

			<Border Background="#F8F9FA" CornerRadius="5" Padding="10" Margin="0,10">
				<StackPanel>
					<TextBlock Text="Расчет стоимости" FontWeight="Bold" FontSize="14"/>
					<TextBlock x:Name="txtDaysCount" Margin="0,5,0,0"/>
					<TextBlock x:Name="txtPricePerDay" Margin="0,2"/>
					<TextBlock x:Name="txtTotalAmount" FontWeight="Bold" FontSize="16" 
                               Foreground="#1A237E" Margin="0,5"/>
				</StackPanel>
			</Border>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
				<Button Content="Оформить" Width="120" Height="35" Margin="5"
                        Background="#1A237E" Foreground="White" FontWeight="Bold"
                        Click="btnConfirm_Click"/>
				<Button Content="Отмена" Width="120" Height="35" Margin="5"
                        Background="#E74C3C" Foreground="White" FontWeight="Bold"
                        Click="btnCancel_Click"/>
			</StackPanel>
		</StackPanel>
	</Grid>
</Window>