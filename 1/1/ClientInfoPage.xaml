<Page x:Class="Прокат_авто.ClientInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Информация"
      Background="#ECF0F1">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Grid Margin="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Информация о каршеринге -->
			<Border Grid.Row="0" Background="White" CornerRadius="5" Padding="20" Margin="0,0,0,15">
				<StackPanel>
					<TextBlock Text="🚗 О каршеринге Drive" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
					<TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="1.5">
                        <Run Text="Drive - это современный каршеринговый сервис, предоставляющий автомобили в аренду на любой срок. " FontWeight="Bold"/>
                        <Run Text="Мы начали свою работу в 2020 году и за это время завоевали доверие тысяч клиентов. "/>
                        <LineBreak/>
                        <Run Text="Наш автопарк насчитывает более 50 автомобилей различных классов: от эконом до премиум. "/>
                        <LineBreak/>
                        <Run Text="Все автомобили проходят регулярное техническое обслуживание и находятся в отличном состоянии. "/>
                        <LineBreak/>
                        <Run Text="Мы предлагаем гибкие тарифы, круглосуточную поддержку. "/>
                        <LineBreak/>
                        <Run Text="Присоединяйтесь к Drive и наслаждайтесь свободой передвижения!"/>
					</TextBlock>
				</StackPanel>
			</Border>

			<!-- Контакты -->
			<!-- Контакты - простой список -->
			<Border Grid.Row="1" Background="White" CornerRadius="5" Padding="20" Margin="0,0,0,15">
				<StackPanel>
					<TextBlock Text="📞 Контакты" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

					<TextBlock Margin="0,5" TextWrapping="Wrap">
            <Run Text="📞 " FontSize="16"/>
            <Run Text="Телефон: " FontWeight="Bold"/>
            <Run Text="8 (800) 555-35-35" Foreground="#3498DB" FontWeight="Bold"/>
					</TextBlock>

					<TextBlock Margin="0,10,0,5" TextWrapping="Wrap">
            <Run Text="💬 " FontSize="16"/>
            <Run Text="WhatsApp/Telegram: " FontWeight="Bold"/>
            <Run Text="+7 (999) 123-45-67" Foreground="#3498DB" FontWeight="Bold"/>
					</TextBlock>

					<TextBlock Margin="0,10,0,5" TextWrapping="Wrap">
            <Run Text="✉️ " FontSize="16"/>
            <Run Text="Email: " FontWeight="Bold"/>
            <Run Text="support@drive-carsharing.ru" Foreground="#3498DB" FontWeight="Bold"/>
					</TextBlock>

					<TextBlock Margin="0,10,0,5" TextWrapping="Wrap">
            <Run Text="📍 " FontSize="16"/>
            <Run Text="Адрес: " FontWeight="Bold"/>
            <Run Text="г. Москва, ул. Тверская, д. 15"/>
					</TextBlock>

					<TextBlock Margin="0,10,0,5" TextWrapping="Wrap">
            <Run Text="🕐 " FontSize="16"/>
            <Run Text="Время работы: " FontWeight="Bold"/>
            <Run Text="Круглосуточно, без выходных" Foreground="#27AE60" FontWeight="Bold"/>
					</TextBlock>
				</StackPanel>
			</Border>

			<!-- Скидки -->
			<Border Grid.Row="2" Background="White" CornerRadius="5" Padding="20" Margin="0,0,0,15">
				<StackPanel>
					<TextBlock Text="🎁 Наши скидки и акции" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

					<ItemsControl x:Name="discountsList">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#F8F9FA" CornerRadius="5" Padding="15" Margin="0,0,0,10">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<StackPanel Grid.Column="0">
											<TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
											<TextBlock Text="{Binding Description}" FontSize="13" Foreground="#7F8C8D" Margin="0,5,0,0" TextWrapping="Wrap"/>
										</StackPanel>

										<Border Grid.Column="1" Background="#2ECC71" CornerRadius="20" Padding="15,5">
											<TextBlock Text="{Binding Percent}" FontSize="18" FontWeight="Bold" Foreground="White"/>
										</Border>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>

			<!-- Штрафы -->
			<Border Grid.Row="3" Background="White" CornerRadius="5" Padding="20" Margin="0,0,0,15">
				<StackPanel>
					<TextBlock Text="⚠️ Штрафы и нарушения" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

					<ItemsControl x:Name="penaltiesList">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#FDF2F2" CornerRadius="5" Padding="15" Margin="0,0,0,10" BorderBrush="#E74C3C" BorderThickness="1">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<StackPanel Grid.Column="0">
											<TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#C0392B"/>
											<TextBlock Text="{Binding Description}" FontSize="13" Foreground="#7F8C8D" Margin="0,5,0,0" TextWrapping="Wrap"/>
										</StackPanel>

										<Border Grid.Column="1" Background="#E74C3C" CornerRadius="20" Padding="15,5">
											<TextBlock Text="{Binding Summ}" FontSize="18" FontWeight="Bold" Foreground="White"/>
										</Border>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock Text="⚠️ Внимание: все штрафы списываются с бонусного счета или добавляются к сумме аренды" 
                               FontSize="12" Foreground="#E74C3C" TextWrapping="Wrap" Margin="0,15,0,0"/>
				</StackPanel>
			</Border>

			<!-- Отзывы -->
			<Border Grid.Row="4" Background="White" CornerRadius="5" Padding="20">
				<StackPanel>
					<TextBlock Text="⭐ Отзывы наших клиентов" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

					<ItemsControl x:Name="reviewsList">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#F8F9FA" CornerRadius="5" Padding="15" Margin="0,0,0,10">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
										</Grid.ColumnDefinitions>

										<Border Grid.Column="0" Width="50" Height="50" Background="#3498DB" CornerRadius="25" 
                                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,15,0">
											<TextBlock Text="{Binding Initials}" FontSize="18" FontWeight="Bold" 
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Border>

										<StackPanel Grid.Column="1">
											<TextBlock>
                                                <Run Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                <Run Text=" ⭐ " Foreground="#F39C12" FontSize="12"/>
                                                <Run Text="{Binding Rating}" Foreground="#F39C12" FontSize="12"/>
											</TextBlock>
											<TextBlock Text="{Binding Comment}" FontSize="13" Foreground="#7F8C8D" 
                                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
											<TextBlock Text="{Binding Date}" FontSize="11" Foreground="#BDC3C7" Margin="0,5,0,0"/>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>
		</Grid>
	</ScrollViewer>
</Page>