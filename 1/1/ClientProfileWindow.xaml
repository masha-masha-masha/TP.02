<Window x:Class="Прокат_авто.ClientProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Главная - Система аренды авто" 
        Height="700" 
        Width="1100"
        WindowStartupLocation="CenterScreen">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Верхняя панель с вкладками -->
		<Border Grid.Row="0" Background="#1A237E" Padding="10">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<Image Style="{StaticResource logoImageStyle}" Margin="0,3,79,0" Height="56" Width="130"/>
				<Button x:Name="btnCatalog" Content="Каталог" Width="120" Height="35" Margin="5"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        Click="btnCatalog_Click"/>
				<Button x:Name="btnProfile" Content="Профиль" Width="120" Height="35" Margin="5"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        Click="btnProfile_Click"/>
				<Button x:Name="btnContracts" Content="Договоры" Width="120" Height="35" Margin="5"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        Click="btnContracts_Click"/>
				<Button x:Name="btnInfo" Content="Информация" Width="120" Height="35" Margin="5"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        Click="btnInfo_Click"/>
				<Button x:Name="btnLogout" Content="Выход" Width="120" Height="35" Margin="5"
                        Background="#E74C3C" Foreground="White" FontWeight="Bold"
                        Click="btnLogout_Click"/>
			</StackPanel>
		</Border>

		<!-- Контентная область -->
		<Border Grid.Row="1" Background="#ECF0F1" Padding="10">
			<Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
		</Border>
	</Grid>
</Window>